# Customer Data Quality SaaS (UC-01) Environment Variables
# Copy this file to .env: cp .env.example .env (NEVER commit .env)

# PostgreSQL database connection string (MUST use postgresql+psycopg:// scheme with psycopg 3 driver)
# Option A: Cloud Neon / Azure PostgreSQL (requires sslmode=require)
DATABASE_URL=postgresql+psycopg://user:password@ep-sample-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Option B: Plain local PostgreSQL (sslmode omitted)
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/customer_saas

# Secret key used for signing and verifying HS256 JWT session tokens.
# Must be at least 32 characters. Generate using:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_generate_with_secrets_token_urlsafe_48

# Subscription metadata storage mechanism: 'file' (local subscriptions.json) or 'blob' (Azure Blob Storage)
SUBSCRIPTION_STORE=file

# Test hook flag: set to 'true' to honour the X-Force-Failure header for testing; 'false' in production
ENABLE_TEST_HOOKS=false
