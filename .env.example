# Customer Data Quality SaaS (UC-01) Environment Variables
# Copy this file to .env: cp .env.example .env (NEVER commit .env)

# PostgreSQL database connection string (Neon serverless or local)
# MUST use the postgresql+psycopg:// scheme with psycopg 3 driver and sslmode=require
DATABASE_URL=postgresql+psycopg://user:password@ep-sample-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Secret key used for signing and verifying HS256 JWT session tokens (at least 32 characters)
JWT_SECRET=super-secret-jwt-key-for-local-development-minimum-32-chars

# Subscription metadata storage mechanism: 'file' (local subscriptions.json) or 'blob' (Azure Blob Storage)
SUBSCRIPTION_STORE=file

# Test hook flag: set to 'true' to honour the X-Force-Failure header for testing; 'false' in production
ENABLE_TEST_HOOKS=false
